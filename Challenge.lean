module

public import Mathlib

/-! The field index of a rational plane curve parametrization. -/
@[expose] public section
noncomputable section
namespace CommonRulerField
open Polynomial
variable {k : Type*} [Field k]

abbrev lin (c : k) : k[X] := X - C c
abbrev liftP (p : k[X]) : RatFunc k := algebraMap k[X] (RatFunc k) p
/-- Normalized weak reading with variable pole order. -/
def weakMap (k : Type*) [Field k] (n : ℕ) : RatFunc k :=
  liftP (lin 1) / liftP (X ^ n : k[X])

/-- Normalized ratio reading with a double zero at one. -/
def ratioMap (K : k) (m : ℕ) : RatFunc k :=
  liftP (lin 1 ^ 2) / liftP (lin K ^ m)

end CommonRulerField

namespace PDTGauge.Result

/-- The index of the field generated by both measurements, for every choice of the two
pole orders. The exceptional specialization is an actual quadratic extension. -/
theorem joint_degree_classification (K : ℝ) (hK : 1<K) (n m : ℕ) (hn : 2 ≤ n) (hm : 2 ≤ m) :
    Module.finrank (IntermediateField.adjoin ℝ
      {CommonRulerField.weakMap ℝ n, CommonRulerField.ratioMap K m}) (RatFunc ℝ) =
      if n = 2 ∧ m = 4 ∧ K = 2 then 2 else 1 := by sorry

end PDTGauge.Result
