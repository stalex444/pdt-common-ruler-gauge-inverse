module

public import CommonRuler.FunctionField
public import CommonRuler.Resonance

/-! The degree of the parametrization defined by the two common-ruler functions. -/
@[expose] public section
noncomputable section
namespace PDTGauge.Result

/-- The index of the field generated by both measurements, for every choice of the two
pole orders. The exceptional specialization is an actual quadratic extension. -/
theorem joint_degree_classification (K : ℝ) (hK : 1<K) (n m : ℕ) (hn : 2 ≤ n) (hm : 2 ≤ m) :
    Module.finrank (IntermediateField.adjoin ℝ
      {CommonRulerField.weakMap ℝ n, CommonRulerField.ratioMap K m}) (RatFunc ℝ) =
      if n = 2 ∧ m = 4 ∧ K = 2 then 2 else 1 := by
  by_cases h : n = 2 ∧ m = 4 ∧ K = 2
  · simp only [h]
    obtain ⟨rfl,rfl,rfl⟩ := h
    exact CommonRulerField.exceptional_index
  simp only [h, ↓reduceIte]
  apply IntermediateField.finrank_eq_one_iff_eq_top.mpr
  by_cases hm2 : m = 2*n
  · subst m
    apply CommonRulerField.resonant_recovery K hK n hn
    rintro ⟨rfl,rfl⟩
    exact h ⟨rfl,rfl,rfl⟩
  exact CommonRulerField.nonresonant_recovery K (by linarith) hK.ne' n m hn hm hm2

end PDTGauge.Result
